# Archives/objects must never get CRLF conversion (empty musl stub .a files look like text)
*.a binary
*.o binary

# Files executed inside EquantOS must keep LF endings on Windows checkouts
*.sh text eol=lf
.bashrc text eol=lf

# Vendored third-party sources are stored byte-for-byte as upstream ships them
/ports/*/src/** -text

# The NetSurf port is built inside Alpine: patches and site scripts must stay LF
/ports/netsurf/patches/** text eol=lf
/ports/netsurf/overlay/** text eol=lf
/ports/netsurf/Makefile.config text eol=lf
