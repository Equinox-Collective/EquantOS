 /**
+ * Media element (HTML5 video): shown as a player object.
+ *
+ * The player (image/video.c) streams the media itself; the object it is
+ * created from only carries a description of the element as "key=value"
+ * lines in a data: URL.
+ */
+static bool
+box_video(dom_node *n,
+	  html_content *content,
+	  struct box *box,
+	  bool *convert_children)
+{
+	static const char * const flags[] = { "autoplay", "loop", "muted" };
+	static const char * const numbers[] = { "width", "height" };
+	dom_string *src = NULL;
+	dom_exception err;
+	nsurl *media = NULL, *url;
+	char *desc, *value, *escaped, *data_url;
+	unsigned int i;
+	bool ok;
+
+	if (box->style && ns_computed_display(box->style,
+			box_is_root(n)) == CSS_DISPLAY_NONE)
+		return true;
+
+	/* the element's src, or else that of its first <source> */
+	err = dom_element_get_attribute(n, corestring_dom_src, &src);
+	if (err != DOM_NO_ERR)
+		return true;
+	if (src == NULL) {
+		dom_node *child = NULL, *next;
+
+		err = dom_node_get_first_child(n, &child);
+		while (err == DOM_NO_ERR && child != NULL && src == NULL) {
+			dom_node_type type;
+			dom_string *name = NULL;
+
+			if (dom_node_get_node_type(child, &type) == DOM_NO_ERR &&
+			    type == DOM_ELEMENT_NODE &&
+			    dom_node_get_node_name(child, &name) == DOM_NO_ERR &&
+			    name != NULL) {
+				if (strcasecmp(dom_string_data(name),
+						"source") == 0) {
+					err = dom_element_get_attribute(child,
+							corestring_dom_src, &src);
+					if (err != DOM_NO_ERR)
+						src = NULL;
+				}
+				dom_string_unref(name);
+			}
+			next = NULL;
+			err = dom_node_get_next_sibling(child, &next);
+			dom_node_unref(child);
+			child = next;
+		}
+		if (child != NULL)
+			dom_node_unref(child);
+	}
+	if (src == NULL)
+		return true; /* nothing to play: show the fallback content */
+
+	ok = box_extract_link(content, src, content->base_url, &media);
+	dom_string_unref(src);
+	if (ok == false)
+		return false;
+	if (media == NULL)
+		return true;
+
+	desc = talloc_asprintf(content->bctx, "url=%s\n", nsurl_access(media));
+	nsurl_unref(media);
+	if (desc == NULL)
+		return false;
+
+	value = NULL;
+	if (box_get_attribute(n, "poster", content->bctx, &value) &&
+			value != NULL && value[0] != '\0') {
+		nsurl *poster;
+
+		if (nsurl_join(content->base_url, value, &poster) ==
+				NSERROR_OK) {
+			desc = talloc_asprintf_append(desc, "poster=%s\n",
+					nsurl_access(poster));
+			nsurl_unref(poster);
+		}
+	}
+	for (i = 0; i < 3 && desc != NULL; i++) {
+		value = NULL;
+		if (box_get_attribute(n, flags[i], content->bctx, &value) &&
+				value != NULL)
+			desc = talloc_asprintf_append(desc, "%s=1\n", flags[i]);
+	}
+	for (i = 0; i < 2 && desc != NULL; i++) {
+		value = NULL;
+		if (box_get_attribute(n, numbers[i], content->bctx, &value) &&
+				value != NULL && atoi(value) > 0)
+			desc = talloc_asprintf_append(desc, "%s=%d\n",
+					numbers[i], atoi(value));
+	}
+	value = NULL;
+	if (desc != NULL &&
+	    box_get_attribute(n, "data-duration", content->bctx, &value) &&
+	    value != NULL && atof(value) > 0)
+		desc = talloc_asprintf_append(desc, "duration=%s\n", value);
+	if (desc == NULL)
+		return false;
+
+	if (url_escape(desc, false, NULL, &escaped) != NSERROR_OK)
+		return false;
+	data_url = talloc_asprintf(content->bctx,
+			"data:" NSVIDEO_MIME_TYPE ",%s", escaped);
+	free(escaped);
+	if (data_url == NULL)
+		return false;
+	if (nsurl_create(data_url, &url) != NSERROR_OK)
+		return false;
+
+	box->flags |= IS_REPLACED;
+	ok = html_fetch_object(content, url, box, CONTENT_IMAGE, false);
+	nsurl_unref(url);
+
+	*convert_children = false;
+	return ok;
+}
+
