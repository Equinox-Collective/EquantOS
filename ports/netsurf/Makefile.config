# NetSurf build configuration for EquantOS (copied to netsurf/Makefile.config)

# libnsfb surface used when no -f option is given: an X11 window via xcb
override NETSURF_FB_FRONTEND := x

# anti-aliased text from the DejaVu fonts shipped in the package
override NETSURF_FB_FONTLIB := freetype
override NETSURF_FB_FONTPATH := /usr/share/fonts/truetype/dejavu
override NETSURF_FB_FONT_CURSIVE := DejaVuSerif.ttf
override NETSURF_FB_FONT_FANTASY := DejaVuSans-Bold.ttf

override NETSURF_FRAMEBUFFER_RESOURCES := /usr/share/netsurf
override NETSURF_FB_RESPATH := $${HOME}/.netsurf/:$${NETSURFRES}:/usr/share/netsurf

override NETSURF_USE_CURL := YES
override NETSURF_USE_OPENSSL := YES
override NETSURF_USE_DUKTAPE := YES
override NETSURF_USE_PNG := YES
override NETSURF_USE_JPEG := YES
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_WEBP := YES
override NETSURF_USE_BMP := YES
override NETSURF_USE_GIF := YES
override NETSURF_USE_NSSVG := YES
override NETSURF_USE_ROSPRITE := NO
override NETSURF_USE_HARU_PDF := NO
override NETSURF_USE_VIDEO := NO
override NETSURF_USE_NSPSL := YES
override NETSURF_USE_NSLOG := YES
override NETSURF_USE_UTF8PROC := YES
# musl has iconv() built into libc: "plug" mode keeps -liconv off the link line
override NETSURF_USE_LIBICONV_PLUG := YES

# EquantOS only runs static executables
LDFLAGS += -static -no-pie
CFLAGS += -fno-pie -fno-pic
