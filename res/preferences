# EquantOS IceWM defaults (copied to /etc/icewm and $ICEWM_PRIVCFG by start.sh).
# A theme loaded later overrides colours, images and fonts set here, so these
# fonts only fill in what a theme leaves out.

# Fonts: the bundled JetBrains Mono Nerd Font ("JetBrainsMono NF" in fontconfig)
TitleFontNameXft="JetBrainsMono NF,monospace:size=10:bold"
MenuFontNameXft="JetBrainsMono NF,monospace:size=10"
StatusFontNameXft="JetBrainsMono NF,monospace:size=9"
QuickSwitchFontNameXft="JetBrainsMono NF,monospace:size=10:bold"
NormalButtonFontNameXft="JetBrainsMono NF,monospace:size=9"
ActiveButtonFontNameXft="JetBrainsMono NF,monospace:size=9:bold"
ToolButtonFontNameXft="JetBrainsMono NF,monospace:size=9"
NormalTaskBarFontNameXft="JetBrainsMono NF,monospace:size=9"
ActiveTaskBarFontNameXft="JetBrainsMono NF,monospace:size=9:bold"
NormalWorkspaceFontNameXft="JetBrainsMono NF,monospace:size=9"
ActiveWorkspaceFontNameXft="JetBrainsMono NF,monospace:size=9:bold"
MinimizedWindowFontNameXft="JetBrainsMono NF,monospace:size=9"
ListBoxFontNameXft="JetBrainsMono NF,monospace:size=10"
ToolTipFontNameXft="JetBrainsMono NF,monospace:size=9"
ClockFontNameXft="JetBrainsMono NF,monospace:size=9:bold"
ApmFontNameXft="JetBrainsMono NF,monospace:size=9"
InputFontNameXft="JetBrainsMono NF,monospace:size=10"
LabelFontNameXft="JetBrainsMono NF,monospace:size=10"

# Taskbar and workspaces
TaskBarShowStartMenu=1
TaskBarShowWindowListMenu=1
TaskBarShowWorkspaces=1
TaskBarShowWindows=1
TaskBarShowClock=1
TaskBarShowShowDesktopButton=1
TimeFormat="%H:%M"
WorkspaceNames=" 1 ", " 2 ", " 3 ", " 4 "

# Themes menu lists every theme under /usr/share/icewm/themes
ShowThemesMenu=1
ShowSettingsMenu=1

# Status monitors: memory reads /proc/meminfo; CPU, network, APM and mail have
# no kernel data source yet
TaskBarShowMEMStatus=1
TaskBarShowCPUStatus=0
TaskBarShowNetStatus=0
TaskBarShowAPMStatus=0
TaskBarShowMailBoxStatus=0

# Window behaviour
ClickToFocus=1
RaiseOnFocus=1
FocusOnAppRaise=1
OpaqueMove=1
OpaqueResize=1
QuickSwitch=1
QuickSwitchToAllWorkspaces=0
